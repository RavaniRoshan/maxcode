[0.586999, "o", "cat > app.py <<'PY'\r\r\n\u001b[?2004l\r\u001b[?2004h> def add(a, b):\r\r\n\u001b[?2004l\r\u001b[?2004h>     return a - b\r\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\r\n\u001b[?2004l\r\u001b[?2004h$ "]
[1.067986, "o", "cat > tests/test_app.py <<'PY'\r\r\n\u001b[?2004l\r\u001b[?2004h> from app import add\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> def test_add():\r\r\n\u001b[?2004l\r\u001b[?2004h>     assert add(2, 3) == 5\r\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\r\n\u001b[?2004l\r\u001b[?2004h$ "]
[3.152006, "o", "cat > maxcode.toml <<'TOML'\r\r\n\u001b[?2004l\r\u001b[?2004h> [provider.pollinations]\r\r\n\u001b[?2004l\r\u001b[?2004h> base_url    = \"https://text.pollinations.ai/openai\"\r\r\n\u001b[?2004l\r\u001b[?2004h> api_key_env = \"POLLINATIONS_KEY\"\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> [provider.local]\r\r\n\u001b[?2004l\r\u001b[?2004h> base_url    = \"http://127.0.0.1:11434/v1\"\r\r\n\u001b[?2004l\r\u001b[?2004h> api_key_env = \"OLLAMA_API_KEY\"\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> [planner]\r\r\n\u001b[?2004l\r\u001b[?2004h> provider = \"pollinations\"\r\r\n\u001b[?2004l\r\u001b[?2004h> model    = \"openai\"\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> [worker]\r\r\n\u001b[?2004l\r\u001b[?2004h> provider = \"local\"\r\r\n\u001b[?2004l\r\u001b[?2004h> model    = \"qwen2.5:3b\"\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> [limits]\r\r\n\u001b[?2004l\r\u001b[?2004h> max_retries_per_step  = 2\r\r\n\u001b[?2004l\r\u001b[?2004h> max_cost_usd_per_task = 0.50\r\r\n\u001b[?2004l\r\u001b[?2004h> max_diff_lines        = 200\r\r\n\u001b[?2004l\r\u001b[?2004h> max_steps             = 1\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> [checks]\r\r\n\u001b[?2004l\r\u001b[?2004h> test = \"python3 -m pytest -q\"\r\r\n\u001b[?2004l\r\u001b[?2004h> TOML\r\r\n\u001b[?2004l\r\u001b[?2004h$ "]
